# ============================================================
# فایل نمونه متغیرهای محیطی پروژه آزمونیار
# این فایل را کپی کرده و با نام .env ذخیره کنید
# مقادیر خالی را قبل از اجرا تکمیل کنید
# ============================================================

# ===== API (NestJS) =====
# تنظیمات سرور اصلی بک‌اند

NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://azmoonyar:secret@localhost:5432/azmoonyar_dev
REDIS_URL=redis://localhost:6379
JWT_SECRET=change_this_to_a_long_random_secret_in_production
JWT_REFRESH_SECRET=change_this_to_another_long_random_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ===== MinIO (ذخیره‌سازی فایل) =====
# تنظیمات سرویس ذخیره‌سازی آبجکت برای آپلود فایل و تصویر

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=azmoonyar

# ===== ایمیل =====
# تنظیمات SMTP برای ارسال ایمیل (در محیط توسعه از MailHog استفاده می‌شود)

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@azmoonai.ir

# ===== پیامک (کاوه‌نگار) =====
# تنظیمات سرویس ارسال پیامک برای احراز هویت OTP

SMS_PROVIDER=kaveneghar
KAVENEGHAR_API_KEY=
KAVENEGHAR_SENDER=

# ===== پرداخت =====
# تنظیمات درگاه‌های پرداخت زرین‌پال و آیدی‌پی

ZARINPAL_MERCHANT_ID=
IDPAY_API_KEY=
IDPAY_SANDBOX=true

# ===== سرویس هوش مصنوعی (Python FastAPI) =====
# کلیدهای API مدل‌های زبانی — اولویت: DeepSeek → OpenRouter → Gemini → OpenAI

DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_SERVICE_PORT=8000

# ===== وب (Next.js) =====
# متغیرهای عمومی فرانت‌اند (با پیشوند NEXT_PUBLIC_ در مرورگر در دسترس هستند)

NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SENTRY_DSN=

# ===== آدرس‌های سرویس‌ها =====
# آدرس داخلی سرویس‌ها برای ارتباط بین سرویس‌ها

FRONTEND_URL=http://localhost:3000
AI_SERVICE_URL=http://localhost:8000
APP_URL=http://localhost:4000

# ===== Sentry (ردیابی خطا) =====
# تنظیمات سرویس Sentry برای مانیتورینگ و ردیابی خطاها در محیط تولید

SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ===== ربات تلگرام (اختیاری) =====
# توکن ربات تلگرام برای ارسال اعلان‌ها (در صورت نیاز)

TELEGRAM_BOT_TOKEN=
