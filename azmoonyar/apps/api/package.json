    "@types/passport-jwt": "^4.0.0",
    "@types/qrcode": "^1.5.0",
    "@types/uuid": "^9.0.0",
    "jest": "^29.7.0",
    "prisma": "^5.12.0",
    "supertest": "^6.3.0",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.0",
    "typescript": "^5.4.0"
  }
